<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  复杂 SQL 才写在这里。单表 CRUD / 简单条件 / 排序 / 计数用 BaseMapperPlus，不要进这个文件。
  开发记录（dev_log）目前只有单表 CRUD，暂无自定义 SQL，保留空 mapper 占位。

  约定：
    · namespace = Mapper 接口全限定名；语句 id = 接口方法名
    · 普通值一律 #{param} 绑定，禁止 ${} 拼接（${} 只允许接收服务端可信 Wrapper）
    · 多参数用 @Param 明确命名
    · 不写 SELECT *，用 resultMap 显式列，避免联表字段冲突和敏感字段泄漏
    · 分页由 MyBatis-Plus 分页插件接管，这里不要手写 LIMIT
-->
<mapper namespace="org.dromara.compliance.mapper.DevLogMapper">

</mapper>
